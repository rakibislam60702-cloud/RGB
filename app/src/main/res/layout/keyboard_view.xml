<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121418"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- VIP-Only Glowing Incoming/Active Call Banner (Visible ONLY while keyboard is open during calls) -->
    <LinearLayout
        android:id="@+id/callBannerBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="3dp"
        android:background="#121830"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📞 Incoming Call..."
            android:textColor="#00F5D4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCallReceive"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="📞 Receive"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCallEnd"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="📵 End"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ultra-Clean Single-Button Top Toolbar: Rakib official (Permanent Free) | 😊 | 📋 | Aa | 🎙 | ✨ AI -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/tvBrandSignature"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:text="@string/brand_header_title"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEmoji"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_emoji"
            android:gravity="center"
            android:text="😊"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnClipboard"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_clipboard"
            android:gravity="center"
            android:text="📋"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnStylishFonts"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_stylish_fonts"
            android:gravity="center"
            android:text="@string/toolbar_stylish_fonts"
            android:textColor="#E2E8F0"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_voice_mic"
            android:scaleType="centerInside"
            android:src="@drawable/ic_kb_mic" />

        <TextView
            android:id="@+id/btnKeyboardSettings"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.9"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_keyboard_settings"
            android:gravity="center"
            android:text="⚙️"
            android:textColor="#E2E8F0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnAiHub"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_ai_hub"
            android:gravity="center"
            android:minWidth="58dp"
            android:paddingHorizontal="11dp"
            android:text="@string/toolbar_ai_hub"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Inline Direct Same-Language Voice Typing Bar (bn-BD / en-IN / hi-IN) -->
    <LinearLayout
        android:id="@+id/voiceBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="3dp"
        android:background="#171128"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvVoiceLangBadge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="#261B47"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="EN"
            android:textColor="#00F5D4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVoiceStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/voice_listening_en"
            android:textColor="#00F5D4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoiceStop"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#3A152C"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:text="✕"
            android:textColor="#FF6B8A"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Inline AI Topic Typing Bar (Active when typing a custom topic directly with keyboard keys) -->
    <LinearLayout
        android:id="@+id/aiTopicTypingBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="3dp"
        android:background="#161028"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAiTopicDraft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:text="@string/ai_hub_topic_hint"
            android:textColor="#F1F5FF"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnAiTopicGenerateNow"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/ai_hub_generate_btn"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAiTopicCancel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FF6B8A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Smart Word Prediction & Glowing RGB Neon Sticker Strip -->
    <HorizontalScrollView
        android:id="@+id/suggestionBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#0D0919"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingHorizontal="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/suggestionContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- In-keyboard Clipboard Manager panel (opened via 📋) -->
    <LinearLayout
        android:id="@+id/clipboardPanel"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:background="#11131A"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clipboard_title"
                android:textColor="#4285F4"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClipboardClear"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:backgroundTint="#1E212E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/clipboard_clear_all"
                android:textAllCaps="false"
                android:textColor="#FF5277"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnClipboardClose"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1E212E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="⌨"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvClipboardEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/clipboard_empty"
            android:textColor="#8A94B0"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/clipboardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- In-keyboard Stylish Fonts Panel (opened via Aa) -->
    <LinearLayout
        android:id="@+id/stylishFontPanel"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:background="#0F111A"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stylish_fonts_title"
                android:textColor="#00F5D4"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFontsClose"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:backgroundTint="#1E212E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="⌨"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/stylishFontContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Unified ✨ AI Shayari & Smart Reply Hub Panel (160+ curated lines + Safe Auto-Shayari Generator) -->
    <LinearLayout
        android:id="@+id/aiHubPanel"
        android:layout_width="match_parent"
        android:layout_height="268dp"
        android:background="#0B0716"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Row 1: Compact Topic Input Box + Generate ✨ + Keyboard Return -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAiTopicBox"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:text="@string/ai_hub_topic_hint"
                android:textColor="#9AA4C4"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btnAiGenerate"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/ai_hub_generate_btn"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAiHubClose"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="⌨"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Row 2: 5 Category Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="5dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/aiCategoryTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Optional Generated Banner / Quick Topics Bar -->
        <HorizontalScrollView
            android:id="@+id/aiQuickTopicsScroll"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="5dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/aiQuickTopicsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Scrollable Curated / Generated Shayari Cards (Tap card -> 2x2 Variation Chips) -->
        <ScrollView
            android:id="@+id/aiShayariScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/aiShayariContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Unlimited Categorized Scrollable Emoji Panel (9 Categories + Backspace) -->
    <LinearLayout
        android:id="@+id/emojiPanel"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:background="#11131A"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <!-- Category Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/emojiCategoryTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Scrollable 8-Column Emoji Grid -->
        <GridView
            android:id="@+id/emojiGridView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:horizontalSpacing="2dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="8"
            android:paddingVertical="4dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="4dp" />

        <!-- Emoji Panel Bottom Bar: ABC Return + Active Category Name + Backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnEmojiClose"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:backgroundTint="#1E2434"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="52dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="ABC"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmojiCategoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="#8A94B0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEmojiBackspace"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:backgroundTint="#252A3B"
                android:contentDescription="@string/cd_backspace"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="52dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:text="⌫"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Inline 6-Style Animated & Multi-Color RGB Text Sticker Selector -->
    <LinearLayout
        android:id="@+id/stickerPanel"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:background="#0C0818"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvStickerPhrasePreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/sticker_selector_title"
                android:textColor="#00F5D4"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStickerClose"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1E212E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="⌨"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStickerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/sticker_selector_tap_hint"
            android:textColor="#9AA4C4"
            android:textSize="10.5sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/stickerStyleGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 4-Row Gboard Layout + Touch Spark RGB Canvas Keyboard -->
    <com.example.rgbkeyboard.RgbKeyboardView
        android:id="@+id/rgbKeyboardView"
        android:layout_width="match_parent"
        android:layout_height="232dp" />

    <!-- Bengali 5-Minute Trial Expired Lock Overlay inside System IME -->
    <LinearLayout
        android:id="@+id/trialLockPanel"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:background="#0D101A"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvImeLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/bn_ime_locked_title"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvImeLockSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/bn_ime_locked_subtitle"
            android:textColor="#C5CEE2"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tvImeLockDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#8A94B0"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImeUnlockNow"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#00E5FF"
            android:paddingHorizontal="20dp"
            android:text="@string/bn_ime_locked_button"
            android:textAllCaps="false"
            android:textColor="#001B22"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
